{
  "name": "lizzor",
  "version": "0.1.0",
  "private": true,
  "description": "Lizzor wholesale commerce platform foundation",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:preflight": "tsx server/db/migration-preflight.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx server/db/seed.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore:rehearsal": "tsx scripts/db-restore-rehearsal.ts",
    "recovery:check": "tsx scripts/recovery-consistency.ts",
    "media:migrate": "tsx scripts/migrate-catalog-media-to-app-storage.ts",
    "db:seed:demo": "NODE_ENV=development SEED_DEMO=true tsx server/db/seed-demo.ts",
    "db:remove:demo": "NODE_ENV=development tsx server/db/remove-demo.ts",
    "auth:bootstrap-admin": "tsx server/auth/bootstrap-admin.ts",
    "test:auth": "NODE_ENV=test tsx server/auth/auth.integration.ts",
    "test:catalog": "NODE_ENV=test tsx server/catalog/catalog.integration.ts",
    "test:media-primary-migration": "NODE_ENV=test tsx server/catalog/media-primary-reconciliation.integration.ts",
    "test:category-reconciliation": "NODE_ENV=test tsx server/catalog/category-reference-reconciliation.integration.ts",
    "test:toonies-reconciliation": "NODE_ENV=test tsx server/suppliers/toonies-reference-reconciliation.integration.ts",
    "test:taxonomy-supplier": "NODE_ENV=test tsx server/catalog/taxonomy-supplier.integration.ts",
    "test:toonies": "NODE_ENV=test tsx server/suppliers/toonies.test.ts",
    "test:toonies-stage3": "NODE_ENV=test PAYMENT_PROVIDER=fake TOONIES_ORDER_BOUND_PROCUREMENT_ENABLED=true TOONIES_ORDER_SETTLEMENT_ENABLED=true tsx server/suppliers/toonies-stage3.test.ts",
    "test:financial-interlock": "NODE_ENV=test TOONIES_ORDER_BOUND_PROCUREMENT_ENABLED=true TOONIES_ORDER_SETTLEMENT_ENABLED=true tsx server/financial/operation-reservation.test.ts",
    "test:toonies-db": "NODE_ENV=test tsx server/suppliers/toonies.integration.ts",
    "test:toonies-procurement": "NODE_ENV=test TOONIES_ORDER_BOUND_PROCUREMENT_ENABLED=true tsx server/suppliers/toonies-procurement.integration.ts",
    "test:toonies-procurement-gate": "NODE_ENV=test tsx server/suppliers/toonies-procurement-gate.test.ts",
    "test:toonies-structured-options": "NODE_ENV=test tsx server/suppliers/toonies-structured-options-reconciliation.integration.ts",
    "test:inventory-pricing": "NODE_ENV=test tsx server/inventory/inventory-pricing.integration.ts",
    "test:commerce": "NODE_ENV=test tsx server/orders/commerce.integration.ts",
    "test:checkout-tax": "NODE_ENV=test PAYMENT_PROVIDER=fake tsx server/orders/checkout-tax-integrity.integration.ts",
    "test:payable-total": "NODE_ENV=test tsx server/commerce/payable-total.test.ts",
    "test:shipping": "NODE_ENV=test PAYMENT_PROVIDER=fake tsx server/orders/shipping.integration.ts",
    "test:shipping-rules": "NODE_ENV=test tsx server/shipping/shipping-rules.integration.ts",
    "test:checkout-phone": "tsx shared/checkoutPhone.integration.ts",
    "test:payments": "NODE_ENV=test PAYMENT_PROVIDER=fake tsx server/payments/payments.integration.ts && NODE_ENV=test PAYMENT_PROVIDER=stripe STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET= tsx server/payments/payments-disabled.integration.ts",
    "test:payment-ui": "tsx src/pages/commerce/StripePaymentPanel.test.ts",
    "test:payment-ui:mocked": "vitest run src/pages/commerce/StripePaymentPanel.mocked.test.tsx",
    "test:fulfillment": "NODE_ENV=test tsx server/fulfillment/fulfillment.integration.ts",
    "test:fulfillment-api": "NODE_ENV=test tsx server/fulfillment/fulfillment-api.integration.ts",
    "test:fulfillment-api:cleanup": "NODE_ENV=test tsx server/fulfillment/fulfillment-api-cleanup.integration.ts",
    "test:storefront": "NODE_ENV=test tsx server/catalog/storefront-api.integration.ts",
    "test:homepage-merch-performance": "NODE_ENV=test tsx server/catalog/homepage-merchandising.performance.integration.ts",
    "test:storefront-ui": "tsx src/components/storefront/publicDisplay.test.ts && tsx src/pages/storefront/productCardPresentation.test.ts && tsx src/pages/storefront/bannerPresentation.test.ts && tsx src/pages/storefront/quantityTierSelection.test.ts",
    "test:storefront-banners": "NODE_ENV=test tsx server/storefront/banners.integration.ts",
    "test:wishlist": "NODE_ENV=test tsx server/wishlist/wishlist.integration.ts",
    "test:promotions": "NODE_ENV=test tsx server/promotions/promotions.integration.ts",
    "test:analytics": "NODE_ENV=test tsx server/analytics/analytics.integration.ts",
    "test:reports-responsive": "NODE_ENV=test tsx server/analytics/reports-responsive.integration.ts",
    "test:accounts": "NODE_ENV=test tsx server/accounts/accounts.integration.ts",
    "test:notifications": "NODE_ENV=test tsx server/notifications/notifications.integration.ts",
    "test:resend-webhooks": "NODE_ENV=test RESEND_WEBHOOK_SECRET=whsec_UmVzZW5kV2ViaG9va1Rlc3RTZWNyZXQwMTIzNDU2Nzg5 tsx server/notifications/resend-webhooks.integration.ts",
    "test:operations": "NODE_ENV=test tsx server/operations/operations.integration.ts",
    "test:rbac": "NODE_ENV=test tsx server/auth/rbac.integration.ts",
    "test:customer-care": "NODE_ENV=test tsx server/customer-care/customer-care.integration.ts",
    "test:legal": "NODE_ENV=test tsx server/legal/requirements.test.ts && NODE_ENV=test tsx server/legal/document-reconciliation.integration.ts && NODE_ENV=test tsx server/legal/legal.integration.ts",
    "test:content-cms": "NODE_ENV=test tsx server/content/content-cms.integration.ts",
    "test:legal-ui": "vitest run src/components/legal/CookieConsent.test.tsx src/components/legal/LegalAcceptance.test.tsx",
    "test:mobile-responsive": "tsx scripts/mobile-responsive-smoke.ts",
    "test:mobile-responsive:gate": "bash scripts/mobile-responsive-validation.sh",
    "test:commercial-profit-responsive": "tsx scripts/commercial-profit-responsive.tsx",
    "test:seo": "NODE_ENV=test APP_ORIGIN=https://shop.example.test tsx server/seo.integration.ts",
    "test:production-readiness": "NODE_ENV=production APP_ORIGIN=https://shop.example.test TRUSTED_HOSTS=shop.example.test,www.shop.example.test,shop-deployment.replit.app SESSION_SECRET=production-readiness-test-secret-0123456789 RESEND_WEBHOOK_SECRET=whsec_production_readiness_test STRIPE_SECRET_KEY= STRIPE_PUBLISHABLE_KEY= STRIPE_WEBHOOK_SECRET= tsx server/production-readiness.integration.ts",
    "test:production-start": "NODE_ENV=production APP_ORIGIN=https://lizzor.com TRUSTED_HOSTS=lizzor.com,www.lizzor.com,lizzor-fanosafrica.replit.app SESSION_SECRET=production-start-regression-secret-0123456789 RESEND_WEBHOOK_SECRET=whsec_production_start_test PORT=5052 tsx server/production-start.integration.ts",
    "test:worker-lock": "NODE_ENV=test tsx server/db/worker-lock.integration.ts",
    "test:neon-branch-harness": "NODE_ENV=test tsx server/testing/neon-branch-harness.test.ts",
    "test:neon-branch-crash-recovery": "NODE_ENV=test tsx server/testing/neon-branch-crash-recovery.ts",
    "test:neon-orphan-inspection": "NODE_ENV=test tsx server/testing/neon-orphan-inspection.ts",
    "test:neon-lifecycle": "NODE_ENV=test PAYMENT_PROVIDER=fake TOONIES_ORDER_BOUND_PROCUREMENT_ENABLED=true TOONIES_ORDER_SETTLEMENT_ENABLED=true tsx server/testing/neon-lifecycle-fixture.ts",
    "test:neon-supplier-failure-reversal": "NODE_ENV=test PAYMENT_PROVIDER=fake TOONIES_ORDER_BOUND_PROCUREMENT_ENABLED=true TOONIES_ORDER_SETTLEMENT_ENABLED=true NEON_REVERSAL_MATRIX_DIAGNOSTICS=1 tsx server/testing/neon-supplier-failure-reversal.ts",
    "test:neon-branch-smoke": "NODE_ENV=test tsx server/testing/neon-branch-smoke.ts",
    "test:production-browser": "NODE_ENV=development tsx scripts/production-browser-smoke.ts",
    "test:production-browser:live": "node scripts/production-browser-verification.mjs"
  },
  "dependencies": {
    "@replit/object-storage": "^1.0.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@testing-library/react": "^16.3.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsdom": "^30.0.1",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^1.37.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "resend": "^6.26.0",
    "vitest": "^5.0.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "uuid": "11.1.1"
    }
  }
}
