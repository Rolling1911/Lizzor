modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["chromium", "imagemagick"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-responsive"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "mobile-responsive"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:mobile-responsive:gate"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5050
externalPort = 3002

[[ports]]
localPort = 5051
externalPort = 3000

[[ports]]
localPort = 5052
externalPort = 3003

[[ports]]
localPort = 5053
externalPort = 6800

[[ports]]
localPort = 5054
externalPort = 4200

[[ports]]
localPort = 23636
externalPort = 3001

[[ports]]
localPort = 24678
externalPort = 80

[[ports]]
localPort = 24679
externalPort = 5173


[postMerge]
path = "scripts/post-merge-setup.sh"
timeoutMs = 300000

[deployment]
deploymentTarget = "vm"
run = ["npm", "start"]
build = ["npm", "run", "build"]
ignorePorts = false

[userenv]

[userenv.production]
APP_ORIGIN = "https://lizzor.com"
TRUSTED_HOSTS = "lizzor.com,www.lizzor.com,lizzor-fanosafrica.replit.app"

[objectStorage]
defaultBucketID = "replit-objstore-33df01ef-48b8-4bcf-a2cc-25633fcd8bb2"
